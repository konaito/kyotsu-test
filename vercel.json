{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "buildCommand": "bun run build",
  "outputDirectory": "public",
  "functions": {
    "api/run.ts": {
      "maxDuration": 300,
      "includeFiles": "data/**"
    },
    "api/subjects.ts": {
      "includeFiles": "data/**"
    }
  }
}
