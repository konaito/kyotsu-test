{
  "name": "kousoku-kyotsu-test",
  "module": "src/dev-server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "solve": "bun run src/cli.ts",
    "extract": "bun run src/cli.ts --dry-run",
    "web": "bun run src/dev-server.ts",
    "test": "bun test",
    "benchmark:gemini": "bun run src/scripts/run-gemini-benchmark.ts",
    "benchmark:openjev": ".venv/bin/python scripts/eval_openjev.py",
    "benchmark:qwen": ".venv/bin/python scripts/eval_openjev.py",
    "build": "bun build ./web/index.html --outdir=public --minify"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.85",
    "ai": "^7.0.105"
  }
}
